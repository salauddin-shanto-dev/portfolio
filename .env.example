# -----------------------------------------------------------------------------
# Portfolio configuration
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# IMPORTANT: This site is a static export. Every NEXT_PUBLIC_* value below is
# embedded into the generated HTML/JS at BUILD time and is publicly visible.
# Never put secrets, tokens, or private credentials in these variables.
#
# In GitHub Actions, the same names are read from repository *Variables*
# (Settings -> Secrets and variables -> Actions -> Variables).
# -----------------------------------------------------------------------------

# ---- Required ---------------------------------------------------------------

# Canonical production URL (no trailing slash). Used for canonical URLs,
# Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://salauddin-shanto-dev.github.io

# Website / portfolio name. Used in page titles and Open Graph metadata.
NEXT_PUBLIC_SITE_NAME=Salauddin Shanto

# Default SEO description used when a page does not define its own.
NEXT_PUBLIC_SITE_DESCRIPTION=Backend-focused Software Engineer specializing in PHP, Laravel, REST API engineering, and legacy application modernization.

# Website author (metadata author / creator).
NEXT_PUBLIC_SITE_AUTHOR=Salauddin Shanto

# Public contact email (rendered as a mailto: link).
NEXT_PUBLIC_CONTACT_EMAIL=salauddin.shanto.dev@gmail.com

# Public LinkedIn profile URL.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/salauddin-shanto/

# Public GitHub profile URL.
NEXT_PUBLIC_GITHUB_URL=https://github.com/salauddin-shanto-dev

# Default locale, format `ll` or `ll_CC` (e.g. en, en_US). Drives <html lang>
# and the Open Graph locale.
NEXT_PUBLIC_SITE_LOCALE=en_US

# ---- Optional ---------------------------------------------------------------

# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to
# disable analytics entirely — no analytics script is loaded when unset.
NEXT_PUBLIC_ANALYTICS_ID=
